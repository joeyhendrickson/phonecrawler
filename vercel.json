{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "pip install -r requirements-vercel.txt",
  "ignoreCommand": "[ \"$VERCEL_ENV\" = preview ]",
  "functions": {
    "server.py": {
      "maxDuration": 300
    },
    "app/main.py": {
      "maxDuration": 300
    }
  }
}
